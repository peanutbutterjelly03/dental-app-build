{
  "name": "FLORAL frontend",

  // Matches the Node 24 both local dev machines run, so a Codespace can't
  // diverge from what the team actually builds against.
  // Tag verified against mcr.microsoft.com's tag list 2026-08-08. There is no
  // "1-24-*" tag — the "1-" image-version prefix only pairs with older Node
  // lines. Check the registry before changing this.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",

  // The repo root holds the npm workspaces (client/ + server/), so `npm
  // install` and `npm run dev` work from the default workspace folder.

  "postCreateCommand": "npm install",

  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "openBrowser"
    },
    "4000": {
      "label": "Express API (only if running npm run dev:server)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss"]
    }
  }
}

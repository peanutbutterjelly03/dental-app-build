# FLORAL — backend environment TEMPLATE.
#
# Copy this file to `.env` in the same directory and fill in the values:
#     cp .env.example .env
#
# ⚠ `.env` is gitignored and must STAY that way. This template is committed on
# purpose and must contain PLACEHOLDERS ONLY — never paste a real secret,
# password, connection string or API key into it.

# ─── Database ────────────────────────────────────────────────────────────────
# Atlas connection string. Ask a teammate for the shared cluster URI, or create
# your own free cluster and point at it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/floral?retryWrites=true&w=majority

# The cluster host that counts as PRODUCTION. Maintenance scripts print which
# database they are about to touch and shout when it is this one
# (server/scripts/announceTarget.ts). Optional -- unset, the target is still
# printed, it just cannot be labelled. Dev and production have SEPARATE
# FIELD_ENCRYPTION_SECRETs and the two are not interchangeable.
PRODUCTION_DB_HOST=


# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random strings. Generate one each:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# These two are independent — do not reuse the same value for both.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ⚠⚠ READ BEFORE SETTING THIS ONE.
# AES key for the encrypted patient fields (names, address, contact numbers,
# guardian details, PhilHealth/4Ps ids, allergies, diagnosis, treatment notes).
#
# If you are connecting to a database that ALREADY HAS RECORDS, this MUST be the
# same key those records were encrypted with. A different value does not error
# on startup — it fails later as garbled text or decrypt errors when reading
# students, and there is no way to recover the data afterwards. Changing this on
# a populated database is the single most destructive action in the project.
#
# Only generate a fresh one for a brand-new, empty database.
FIELD_ENCRYPTION_SECRET=must-match-the-key-existing-records-were-encrypted-with

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins. Keep http://localhost:5173 for
# local dev: if Vite ends up on another port (5174 because 5173 was taken),
# every login returns 403 "Origin not allowed", which looks exactly like a wrong
# password.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Seed / demo accounts ────────────────────────────────────────────────────
# Used by the seed scripts and by the Playwright verification scripts. These are
# the ONLY place the demo passwords live outside the database (where they are
# bcrypt-hashed). Pick your own; they are not shared secrets.
#
# ⚠ `npm run seed:demo` SKIPS accounts that already exist, so changing a
# password here does not reach an account that was already created — run
# `npm run apply:seed-passwords` for that.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-password
SEED_DENTIST_PASSWORD=choose-a-password
SEED_AIDE_PASSWORD=choose-a-password
SEED_SCHOOLADMIN_PASSWORD=choose-a-password
SEED_BHO_PASSWORD=choose-a-password

# ─── ML service (OPTIONAL locally) ───────────────────────────────────────────
# Leave both unset for local development. predictionRoutes.ts defaults the URL
# to http://localhost:8000 and sends no API-key header when the key is empty,
# which is what a local `uvicorn main:app --port 8000` expects. Set them in the
# Vercel/Render environments for production.
# ML_SERVICE_URL=https://your-ml-service.onrender.com
# ML_SERVICE_API_KEY=

# ─── Password-reset link host (OPTIONAL) ─────────────────────────────────────
# Base URL used to build the reset link in the email. Only consulted when the
# request carries no Origin header; a browser always sends one, so in normal use
# the link points back at whichever host the request came from. It falls back to
# the production URL, which means an unset value is only a problem for a
# server-to-server reset triggered without an Origin — then the emailed link
# would point at production instead of your machine.
# APP_URL=http://localhost:5173

# ─── Email (OPTIONAL locally) ────────────────────────────────────────────────
# Brevo transactional email, used for password-reset links. With no key,
# mailer.ts LOGS the reset link to the server console instead of sending it, so
# the reset flow is still fully testable without a mail account.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@example.com

# ─── Render API (OPTIONAL, not read by the app) ──────────────────────────────
# A personal Render token for managing the ML service from the CLI/API. Nothing
# in the application reads this; it is listed so it is not deleted as unknown.
# RENDER_API_KEY=

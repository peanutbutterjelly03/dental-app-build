node_modules/
.env
.env.local
dist/
build/

# Real student Excel data — holds until student-name anonymization is
# confirmed with adviser per CLAUDE.md's Phase 3 privacy note. Leading slash
# scopes this to the repo-root data/ only — without it, this also matched
# ml-service/data/ (synthetic placeholder data, meant to be tracked).
/data/

.vercel
.env*
# ...but the committed TEMPLATE is the exception: it carries placeholders only,
# and it is the file that documents how to create a real .env. Without this
# negation the `.env*` rule above silently swallows it.
!.env.example

# Python (ml-service/)
__pycache__/
*.pyc
.venv/

# curl session-cookie files from manual API testing — never commit
cookies.txt

# Raw DB snapshots from backupRaw.ts — real patient PII, never commit
backups/

# Claude Code local session state — machine-specific, never shared
.claude/settings.local.json
.claude/scheduled_tasks.lock

# /impeccable design-hook cache — tooling metadata, not app code
.impeccable/

# Vendored /impeccable skill (~195 files across both copies) — per-machine
# tooling, reinstall it rather than syncing it. NOTE: .codex/hooks.json points
# at .agents/skills/impeccable/scripts/hook.mjs, so that hook no-ops on a
# machine where the skill isn't installed.
.claude/skills/
.agents/skills/

# TypeScript incremental build cache
*.tsbuildinfo

# Other teams' capstone manuscripts, kept locally as writing reference only.
# ~28MB of PDFs that are not ours to redistribute — read them, never commit
# them. Covers the throwaway _scan*.py PDF-extraction scratch scripts too.
docs/reference/

# Word exports generated from the .md sources — regenerate, don't commit binaries
docs/*.docx

# Verifier screenshots — verify_sprint83.mjs defaults its shots directory to
# "." and drops PNGs into the repo when run from project/. Test output, not
# source (Sprint 90).
dental-4-12-main/project/sprint*.png
